# Copy this file to .env and fill in your real key.
# .env is git-ignored - never commit your actual key.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database credentials for docker compose (defaults are fine for local use;
# change them if you ever expose the stack beyond your machine).
POSTGRES_USER=bizai
POSTGRES_PASSWORD=bizai
